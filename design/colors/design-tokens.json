    "light": {
      "shadow-1": "0 1px 2px rgba(18,25,51,.06), 0 1px 3px rgba(18,25,51,.08)",
      "shadow-2": "0 2px 4px rgba(18,25,51,.06), 0 4px 16px rgba(18,25,51,.08)",
      "shadow-3": "0 4px 8px rgba(18,25,51,.06), 0 12px 32px rgba(18,25,51,.12)",
