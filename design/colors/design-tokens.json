{
  "version": "1.1",
  "fonts": {
    "display": "Sora",
    "ui": "Inter",
    "mono": "JetBrains Mono"
  },
  "typography": {
    "display": {
      "size_px": 48,
      "line_height_px": 56,
      "weight": 600,
      "letter_spacing_em": -0.02,
      "family": "display",
      "usage": "Marketing hero, one per page"
    },
    "h1": {
      "size_px": 36,
      "line_height_px": 44,
      "weight": 600,
      "letter_spacing_em": -0.015,
      "family": "display",
      "usage": "Page title"
    },
    "h2": {
      "size_px": 28,
      "line_height_px": 36,
      "weight": 600,
      "letter_spacing_em": -0.01,
      "family": "display",
      "usage": "Section title"
    },
    "h3": {
      "size_px": 22,
      "line_height_px": 30,
      "weight": 600,
      "letter_spacing_em": -0.01,
      "family": "display",
      "usage": "Card or panel title"
    },
    "h4": {
      "size_px": 18,
      "line_height_px": 26,
      "weight": 600,
      "letter_spacing_em": -0.005,
      "family": "display",
      "usage": "Subsection, dialog title"
    },
    "body-lg": {
      "size_px": 18,
      "line_height_px": 28,
      "weight": 400,
      "letter_spacing_em": 0,
      "family": "ui",
      "usage": "Intro paragraphs, marketing body"
    },
    "body": {
      "size_px": 16,
      "line_height_px": 26,
      "weight": 400,
      "letter_spacing_em": 0,
      "family": "ui",
      "usage": "Default text"
    },
    "small": {
      "size_px": 14,
      "line_height_px": 22,
      "weight": 400,
      "letter_spacing_em": 0,
      "family": "ui",
      "usage": "Dense UI, tables, form labels (500)"
    },
    "caption": {
      "size_px": 12,
      "line_height_px": 18,
      "weight": 400,
      "letter_spacing_em": 0.005,
      "family": "ui",
      "usage": "Hints, metadata, badges (500)"
    },
    "code": {
      "size_px": 13,
      "line_height_px": 20,
      "weight": 400,
      "letter_spacing_em": 0,
      "family": "mono",
      "usage": "Payloads, logs, endpoints, IDs"
    }
  },
  "font_weights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "spacing_px": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
