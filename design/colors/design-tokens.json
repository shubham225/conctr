    "dark": {
      "shadow-1": "0 0 0 1px rgba(255,255,255,.04), 0 1px 2px rgba(0,0,0,.4)",
      "shadow-2": "0 0 0 1px rgba(255,255,255,.05), 0 4px 16px rgba(0,0,0,.45)",
