# Local startup defaults for Windows, macOS and Linux.
# Required server connection. Local PostgreSQL credentials may live in ~/.pgpass.
CONCTR_DATABASE_URL=postgresql://conctr-admin@127.0.0.1:5432/conctr
# MariaDB uses SQLx's mysql://USER:PASSWORD@HOST:3306/DATABASE format.

# Optional legacy import source. Its directory also holds private password handoffs.
# A blank path selects the OS user's Conctr directory.
CONCTR_ACCOUNTS_FILE=

# Blank allows the local browser origin. For remote use, set the HTTPS origin.
CONCTR_PUBLIC_ORIGIN=

# Optional when building a packaged desktop/mobile client.
# CONCTR_NATIVE_API_ORIGIN=https://conctr.example.com
